# ── AI for /api/ask (Search, the reader, the library, the .md endpoints and /mcp work without it) ──
# Which AI answers: anthropic (default) | openai | openrouter | groq | ollama | custom
KD_AI_PROVIDER=anthropic
# Model ID. Defaults: anthropic claude-opus-5-5 · openai gpt-5 · openrouter anthropic/claude-opus-5.5 · groq llama-3.3-70b-versatile · ollama llama3.1
KD_MODEL=

# anthropic: Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=

# openai / openrouter / groq / custom: the key (or OPENAI_API_KEY / OPENROUTER_API_KEY / GROQ_API_KEY)
KD_AI_API_KEY=
# custom (or to override a preset's URL): an OpenAI-compatible base URL ending in /v1,
# e.g. http://127.0.0.1:1234/v1 for LM Studio
KD_AI_BASE_URL=

# Optional tuning for smaller / free models:
# how many characters of source passages Ask sends (default 60000; lower it for small context windows)
KD_CONTEXT_CHARS=
# cap on answer length in tokens, if the model rejects the default (16000, or 32000 for requirements)
KD_MAX_TOKENS=

# ── MCP server at /mcp ──
# Optional. When set, MCP clients must send "Authorization: Bearer <token>".
KD_MCP_TOKEN=
